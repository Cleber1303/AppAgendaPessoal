# Banco de dados PostgreSQL.
# No Neon, copie a "Connection string" do painel do projeto.
# Mantenha ?sslmode=require no final.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/agenda?sslmode=require"

# Fuso horário do app. Toda data sem hora é interpretada aqui.
AGENDA_FUSO="America/Sao_Paulo"

# A senha que libera o app. SEM ELA, o app fica trancado em produção.
# Use uma frase longa: é o que protege de verdade contra tentativa em
# massa, já que não há como contar tentativas aqui.
AGENDA_SENHA="troque-por-uma-frase-longa-e-sua"

# Opcional: a chave que assina o cookie de sessão. Sem isso, a própria
# senha assina — o que funciona, e faz trocar a senha derrubar as sessões
# abertas. Definindo em separado, trocar a senha não desconecta ninguém.
# AGENDA_SEGREDO="uma-sequencia-aleatoria-longa"
